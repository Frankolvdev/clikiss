# Generate local private values with npm run db:setup. Never commit .env.local.
POSTGRES_PASSWORD=
POSTGRES_PORT=25432
DATABASE_URL=postgresql://conecta:REPLACE_PASSWORD@127.0.0.1:25432/conecta
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=
MEDIA_ROOT=.data/media
REALTIME_HOST=127.0.0.1
REALTIME_PORT=3001
# Optional. Production defaults to wss://your-domain/realtime behind a reverse proxy.
NEXT_PUBLIC_REALTIME_URL=

# Optional social providers. Secrets belong only on the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# SMTP: local Mailpit defaults during development; configure a real service in production.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Conecta <cuentas@localhost>

# Browser Maps key: restrict it to your websites and Maps JavaScript/Places APIs.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Optional S3-compatible object storage; leave bucket empty for local disk.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MEDIA_QUOTA_MB=500
# Staff must enable TOTP in production by default.
ENFORCE_STAFF_2FA=true
# Optional system ffmpeg; otherwise ffmpeg-static is used.
FFMPEG_PATH=
# Development enables synthetic account generation. Production requires explicit opt-in.
TEST_USERS_ENABLED=false
# Folder library for the fixed population; keep it outside public/.
TEST_USERS_ROOT=test-data/personas

# 1:1 WebRTC. Media travels P2P; TURN is used only when direct ICE fails.
VIDEO_CALLS_ENABLED=true
# Production requires configured TURN unless explicitly changed for diagnostics.
VIDEO_CALLS_REQUIRE_TURN=true
VIDEO_CALL_MAX_ACTIVE=20
VIDEO_CALL_MAX_MINUTES=120
VIDEO_CALL_CPU_LIMIT=0.90
VIDEO_CALL_MIN_FREE_MB=384
# Total host ingress + egress Mbps budget. 0 disables the NETWORK gate only.
VIDEO_CALL_NETWORK_MBPS=0
VIDEO_CALL_NETWORK_FRACTION=0.80
VIDEO_CALL_NETWORK_INTERFACE=
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
VIDEO_CALL_FORCE_RELAY=false
